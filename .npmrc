# This repository is a personal, public project and every dependency in it is a
# public npm package, so it pins the public registry here.
#
# npm applies this file to THIS directory only. The user-level ~/.npmrc - and any
# corporate registry configured there - is left completely untouched, so other
# projects on this machine are unaffected.
#
# It exists because without it `npm install` here rewrites every `resolved` URL in
# package-lock.json to whatever registry ~/.npmrc points at. That breaks
# `npm ci` in GitHub Actions (runners hold no private-registry credentials, so
# every install fails with E401) and publishes an internal registry hostname from
# a public repository.
registry=https://registry.npmjs.org/
