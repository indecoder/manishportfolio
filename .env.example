# ---------------------------------------------------------------------------
# Reference only - do NOT copy this file by hand.
#
# Every stage (dev / uat / prod) is defined in env.config.mjs. To activate one:
#
#   npm run env:dev     (or env:uat / env:prod)
#
# That writes the matching variables into .env.local, which Next.js loads
# automatically. It only rewrites its own marked block, so anything else you put
# in .env.local is preserved. .env.local is gitignored.
#
# The variables apply-env manages:
#
#   NEXT_PUBLIC_APP_STAGE    dev | uat | prod - which stage this build is
#   NEXT_PUBLIC_SITE_URL     canonical origin for <link rel="canonical">,
#                            metadataBase, sitemap, robots, JSON-LD and RSS
#   NEXT_PUBLIC_SITE_NAME    brand name; non-prod builds get a stage suffix
#   NEXT_PUBLIC_INDEXABLE    "true" on prod only - dev/uat are noindex
#   FIREBASE_PROJECT_ID      Firebase project to deploy into
#   FIREBASE_HOSTING_SITE    Hosting site within that project
#
# Anything you export yourself WINS over env.config.mjs, which is how CI injects
# GitHub Actions variables without touching the file. An empty value is ignored
# rather than blanking a working default.
#
# Defaults if you set nothing at all:
#   prod  -> https://fullstackmanish.web.app
#
# For a dev build served from localhost, run `npm run env:dev` and then either
# leave the site URL alone or override it:
#   NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ---------------------------------------------------------------------------
